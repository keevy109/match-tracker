rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /website/{group}/{kind}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'REPLACE_WITH_ADMIN_UID'
        && ((group in ['kader', 'trainer'] && kind in ['portraits', 'detail'])
          || (group == 'vereine' && kind == 'badges'))
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
  }
}
