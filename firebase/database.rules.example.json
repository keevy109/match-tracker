{
  "rules": {
    "website": {
      ".read": true,
      "$collection": {
        ".write": "auth != null && auth.uid === 'REPLACE_WITH_ADMIN_UID' && ($collection === 'kader' || $collection === 'spielplan' || $collection === 'vereine' || $collection === 'trainer')",
        ".validate": "newData.hasChildren(['schema', 'items']) && newData.child('schema').val() === 1 && newData.child('items').isString() && newData.child('items').val().length <= 10000000",
        "schema": { ".validate": "newData.isNumber()" },
        "items": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    }
  }
}
